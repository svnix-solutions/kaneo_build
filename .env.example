# Under Komodo these come from the stack's Environment field, with secrets
# from Komodo secret variables. For local runs, copy to .env.

# Pin a release. Tags: https://github.com/usekaneo/kaneo/pkgs/container/kaneo
# Upstream image by default; a fork can be used instead, e.g.
# KANEO_IMAGE=ghcr.io/svnix-solutions/kaneo  KANEO_VERSION=fn-main
KANEO_IMAGE=ghcr.io/usekaneo/kaneo
KANEO_VERSION=2.46.2

# Public origin (no trailing slash).
KANEO_CLIENT_URL=https://kaneo.example.com

# Shared Postgres (postgres_build). Hex password: openssl rand -hex 32
KANEO_DB_HOST=postgres
KANEO_DB_PORT=5432
KANEO_DB_NAME=kaneo
KANEO_DB_USER=kaneo
KANEO_DB_PASSWORD=changeme

# Session secret. Keep stable. openssl rand -hex 32
KANEO_AUTH_SECRET=changeme

# Shared Redis (redis_build), own DB index. Optional with a single instance.
# KANEO_REDIS_URL=redis://:<redis password>@redis:6379/2

# Close sign-ups. The first account can still register, and invitation
# links still work, so this is safe to set before the owner signs up.
KANEO_DISABLE_REGISTRATION=true
# Anonymous guest access (default: disabled).
KANEO_DISABLE_GUEST_ACCESS=true

KANEO_PORT=5173
DB_NETWORK=db
PROXY_NETWORK=proxy

# Optional, passed through via env_file -- see upstream .env.sample:
# SMTP_HOST= SMTP_PORT= SMTP_SECURE= SMTP_USER= SMTP_PASSWORD= SMTP_FROM=
# GITHUB_OAUTH_CLIENT_ID= GITHUB_OAUTH_CLIENT_SECRET=
# S3_ENDPOINT= S3_BUCKET= S3_ACCESS_KEY_ID= S3_SECRET_ACCESS_KEY= S3_REGION=
# NOTIFICATION_SECRET_ENCRYPTION_KEY=
